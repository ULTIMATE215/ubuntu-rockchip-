+#[test]
+fn rkmpp_encodes_nv12_and_inserts_h264_access_unit_delimiters() {
+    assert!(!full_chroma_for(Encoder::Rkmpp));
+    let h264 = VideoSettings { codec: VideoCodec::H264, ..Default::default() };
+    let args = encoder_options(&h264, Encoder::Rkmpp, "60", None);
+    assert!(args.windows(2).any(|a| a == ["-c:v", "h264_rkmpp"]));
+    assert!(args.windows(2).any(|a| a == ["-pix_fmt", "nv12"]));
+    assert!(args.windows(2).any(|a| a == ["-bsf:v", "h264_metadata=aud=insert"]));
+    let hevc = VideoSettings { codec: VideoCodec::H265, ..Default::default() };
+    let args = encoder_options(&hevc, Encoder::Rkmpp, "60", None);
+    assert!(args.windows(2).any(|a| a == ["-c:v", "hevc_rkmpp"]));
+    assert!(!args.iter().any(|a| a == "-bsf:v"));
+}
